# Environment template. Copy to .env and fill in real values locally.
# .env is git-ignored (PRIV-1640/1641) — never commit real secrets.
#
# NOTE: P4 (this checkpoint) makes no AI calls and reads no environment
# variables at all. The entries below are placeholders for the AI provider
# key that D8/D9 (a later, not-yet-implemented phase) will require. They
# are listed here only so the secrets-exclusion convention is established
# before any real key ever exists, per PRIV-1641.

# Anthropic API key — NOT YET USED by any code in this repository.
ANTHROPIC_API_KEY=

# Backend service port (used by P4's smoke test / local dev server).
BACKEND_PORT=8000
