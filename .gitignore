# ── Secrets / environment (PRIV-1641: excluded from the first commit onward) ──
# No such files exist yet; these patterns are a standing safety net, not
# scaffolding for unbuilt services.
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
secrets/
credentials/

# ── Android / Gradle build artifacts ──
firetv/**/build/
firetv/.gradle/
firetv/captures/
firetv/*.apk
firetv/*.aab
# Broader net for any APK/AAB anywhere in the repo (merged from the P4
# transfer package's reviewed .gitignore).
*.apk
*.aab

# ── Machine-specific local config (breaks on any other machine) ──
firetv/local.properties

# ── Python (backend) ──
backend/__pycache__/
backend/**/__pycache__/
*.pyc
.pytest_cache/
backend/.pytest_cache/
venv/
.venv/
backend/venv/
backend/.venv/
*.egg-info/
.coverage
htmlcov/

# ── Generated evidence-image test output (not source) ──
backend/tests/output/

# ── Backend runtime artifacts (D6 storage). The devices/pairing-code
# SQLite DB (backend/storage/db.py) now actually exists, at
# backend/data/app.db by default -- the original backend/*.db pattern
# below does not match one directory deeper, so backend/data/ is added
# explicitly (git glob "*" does not cross "/"). ──
backend/*.db
backend/*.sqlite3
backend/data/
backend/blobs/

# ── IDE / editor ──
.idea/
*.iml
.vscode/

# ── OS noise ──
.DS_Store
Thumbs.db

# ── Debug/build logs (ephemeral, not source) ──
firetv/build_output.log
# General safety net for any future log output anywhere in the repo
# (merged from the P4 transfer package's reviewed .gitignore).
*.log
logs/

# ── Claude Code harness session state (not project content) ──
.claude/
