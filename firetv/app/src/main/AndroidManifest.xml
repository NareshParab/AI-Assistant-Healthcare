<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fire TV / Android TV devices have no touchscreen and do not
         guarantee the Leanback UI framework itself — both features are
         therefore declared optional, per Fire TV app manifest guidance. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/app_banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.AiAssistantHealthcare">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AiAssistantHealthcare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Required for the app to appear in the Fire TV home
                     screen launcher grid. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- P2 validation POC only (ARCHITECTURE_MVP_PLAN.md Section 12).
             Own launcher tile so it can be reached and exercised with the
             D-pad alone, exactly like MainActivity. Not a product screen. -->
        <activity
            android:name=".P2FocusValidationActivity"
            android:exported="true"
            android:label="@string/p2_validation_label"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AiAssistantHealthcare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
