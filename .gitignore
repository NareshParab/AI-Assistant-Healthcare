# ── Secrets / environment (PRIV-1641: excluded from the first commit onward) ──
# No such files exist yet; these patterns are a standing safety net, not
# scaffolding for unbuilt services.
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json

# ── Android / Gradle build artifacts ──
firetv/**/build/
firetv/.gradle/
firetv/captures/
firetv/*.apk
firetv/*.aab

# ── Machine-specific local config (breaks on any other machine) ──
firetv/local.properties

# ── IDE / editor ──
.idea/
*.iml
.vscode/

# ── OS noise ──
.DS_Store
Thumbs.db

# ── Debug/build logs (ephemeral, not source) ──
firetv/build_output.log

# ── Claude Code harness session state (not project content) ──
.claude/
