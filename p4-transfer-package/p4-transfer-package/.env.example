# AI Assistant Healthcare — backend environment template.
# Copy to .env and fill in locally. NEVER commit a filled-in .env (see .gitignore, PRIV-1640).
# This file contains placeholders only.

# AI provider (D8 — NOT required for the P4 POC; needed only once ASSIST/GUIDE AI (P5+) is built)
ANTHROPIC_API_KEY=

# Backend runtime
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Storage (D6 — server-side SQLite + blob dir for documents/proposals only;
# confirmed clinical data is device-canonical, never stored here)
BACKEND_DB_PATH=./backend/data/app.db
BACKEND_BLOB_DIR=./backend/data/blobs
